#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

ATUM_MIN_PHP="8.2.0"
SOURCE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ATUM_PRESENTATION_COMMAND=
. "$SOURCE_DIR/installer/presentation.sh"
PREFIX="${ATUM_PREFIX:-/usr/share/atum}"
STATE_DIR="${ATUM_STATE_DIR:-/var/lib/atum}"
CONFIG_DIR="${ATUM_CONFIG_DIR:-/etc/atum}"
KAMAILIO_CONFIG="${KAMAILIO_CONFIG:-}"
CHECK_ONLY=0
NO_DEPS=0
INSTALL_COMMITTED=0
USER_CREATED=0
GROUP_CREATED=0
PACKAGES_ADDED=""
ASSUME_YES=0
ALLOW_NO_KAMAILIO=0
DEVELOPMENT_ACK=0
REMOTE_MODE=0
LISTEN_ADDRESS=0.0.0.0
LISTEN_PORT=8443
WEB_SERVER_REQUEST=""
VERBOSE=0
TRANSACTION_DIR="${ATUM_TRANSACTION_DIR:-/var/lib/atum-install-transaction}"
LIFECYCLE_LOCK_PATH="${ATUM_LIFECYCLE_LOCK_PATH:-/run/atum}"
RECOVERED_PACKAGES=""

usage() {
cat <<'EOF'
Atum GUI installer

Usage: ./install [options]

Run from a checkout created with:
  git clone https://github.com/kierknoby/atum.git

The checkout is a read-only installation source. install-files.txt is the
authoritative installed application file set.

  --check                     pre-flight only; make no changes
  --no-deps                   do not install missing OS packages
  --yes, -y                   answer yes to dependency prompts
  --verbose                   show detailed pre-flight, package and service output
  --prefix=/path              application path (default /usr/share/atum)
  --kamailio-config=/path     existing Kamailio configuration
  --allow-no-kamailio         development install without Kamailio
  --development               acknowledge v0.1 is NOT SUITABLE FOR PRODUCTION
  --remote                    check/configure host web server + PHP-FPM + HTTPS
  --listen-address=address    remote listen IP (default 0.0.0.0)
  --listen-port=port          remote HTTPS port (default 8443)
  --web-server=name           nginx or apache (auto-detected when only one exists)
  --help, -h                  show this help
EOF
}

for arg in "$@"; do
    case "$arg" in
        --check) CHECK_ONLY=1 ;;
        --no-deps) NO_DEPS=1 ;;
        --yes|-y) ASSUME_YES=1 ;;
        --verbose) VERBOSE=1 ;;
        --prefix=*) PREFIX=${arg#--prefix=} ;;
        --kamailio-config=*) KAMAILIO_CONFIG=${arg#--kamailio-config=} ;;
        --allow-no-kamailio) ALLOW_NO_KAMAILIO=1 ;;
        --development) DEVELOPMENT_ACK=1 ;;
        --remote) REMOTE_MODE=1 ;;
        --listen-address=*) LISTEN_ADDRESS=${arg#--listen-address=} ;;
        --listen-port=*) LISTEN_PORT=${arg#--listen-port=} ;;
        --web-server=*) WEB_SERVER_REQUEST=${arg#--web-server=} ;;
        --help|-h) usage; exit 0 ;;
        *) echo "Unknown option: $arg" >&2; usage >&2; exit 2 ;;
    esac
done

say() { printf '%s\n' "$*"; }
fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
stage_begin() { say "[$1/6] $2"; }
stage_done() { say "      done"; }

if [ "$CHECK_ONLY" -eq 0 ]; then
    [ "$DEVELOPMENT_ACK" -eq 1 ] || fail "Atum v0.1 is NOT SUITABLE FOR PRODUCTION. Rerun with --development only on a test/non-production host."
    [ "$(id -u)" -eq 0 ] || fail "System installation must run as root."
    command -v flock >/dev/null 2>&1 || fail "System installation requires flock for lifecycle locking."
    case "$LIFECYCLE_LOCK_PATH" in /*) ;; *) fail "Lifecycle lock path must be absolute: $LIFECYCLE_LOCK_PATH" ;; esac
    [ "$LIFECYCLE_LOCK_PATH" != / ] || fail "Lifecycle lock path is unsafe: $LIFECYCLE_LOCK_PATH"
    LOCK_PARENT=$(dirname -- "$LIFECYCLE_LOCK_PATH")
    [ -d "$LOCK_PARENT" ] && [ ! -L "$LOCK_PARENT" ] || fail "Lifecycle lock parent must be an existing directory: $LOCK_PARENT"
    [ "$(stat -c %u "$LOCK_PARENT" 2>/dev/null || echo -1)" = 0 ] || fail "Lifecycle lock parent is not root-owned: $LOCK_PARENT"
    LOCK_PARENT_MODE=$(stat -c %a "$LOCK_PARENT" 2>/dev/null || echo 777)
    [ $((0$LOCK_PARENT_MODE & 0022)) -eq 0 ] || fail "Lifecycle lock parent is writable by non-root users: $LOCK_PARENT"
    if [ ! -e "$LIFECYCLE_LOCK_PATH" ]; then
        mkdir -m 0700 "$LIFECYCLE_LOCK_PATH" || fail "Unable to create lifecycle lock directory: $LIFECYCLE_LOCK_PATH"
    fi
    [ -d "$LIFECYCLE_LOCK_PATH" ] && [ ! -L "$LIFECYCLE_LOCK_PATH" ] || fail "Lifecycle lock path is not a safe directory: $LIFECYCLE_LOCK_PATH"
    [ "$(stat -c %u "$LIFECYCLE_LOCK_PATH" 2>/dev/null || echo -1)" = 0 ] || fail "Lifecycle lock path is not root-owned: $LIFECYCLE_LOCK_PATH"
    LOCK_MODE=$(stat -c %a "$LIFECYCLE_LOCK_PATH" 2>/dev/null || echo 777)
    [ $((0$LOCK_MODE & 0077)) -eq 0 ] || fail "Lifecycle lock path is accessible by non-root users: $LIFECYCLE_LOCK_PATH"
    exec 9< "$LIFECYCLE_LOCK_PATH"
    flock -n 9 || fail "Another Atum install or uninstall operation is already running."
fi

OS_ID=unknown
OS_NAME=Unknown
OS_LIKE=""
KERNEL=$(uname -s 2>/dev/null || echo unknown)
if [ -r /etc/os-release ]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    OS_ID=${ID:-unknown}
    OS_NAME=${PRETTY_NAME:-${NAME:-$OS_ID}}
    OS_LIKE=${ID_LIKE:-}
elif [ "$KERNEL" = Darwin ]; then
    OS_ID=macos
    OS_NAME=macOS
fi

PKG_MANAGER=""
if [ -n "${ATUM_PACKAGE_MANAGER:-}" ]; then
    PKG_MANAGER=$ATUM_PACKAGE_MANAGER
else
    for pm in apt-get dnf yum zypper apk pkg brew; do
        command -v "$pm" >/dev/null 2>&1 && { PKG_MANAGER=$pm; break; }
    done
fi

PHP_VERSION=missing
PHP_OK=0
if command -v php >/dev/null 2>&1; then
    PHP_VERSION=$(php -r 'echo PHP_VERSION;' 2>/dev/null || echo unknown)
    php -r 'exit(version_compare(PHP_VERSION,"8.2.0",">=")?0:1);' >/dev/null 2>&1 && PHP_OK=1
fi
NGINX_DETECTED=0
APACHE_DETECTED=0
command -v nginx >/dev/null 2>&1 && NGINX_DETECTED=1
{ command -v apache2 >/dev/null 2>&1 || command -v httpd >/dev/null 2>&1; } && APACHE_DETECTED=1
WEB_SERVER=none
if [ -n "$WEB_SERVER_REQUEST" ]; then
    case "$WEB_SERVER_REQUEST" in nginx|apache) WEB_SERVER=$WEB_SERVER_REQUEST ;; *) fail "--web-server must be nginx or apache." ;; esac
elif [ -n "${ATUM_WEB_SERVER:-}" ]; then
    case "$ATUM_WEB_SERVER" in nginx|apache|none) WEB_SERVER=$ATUM_WEB_SERVER ;; *) fail "ATUM_WEB_SERVER must be nginx, apache or none." ;; esac
elif [ "$NGINX_DETECTED" -eq 1 ] && [ "$APACHE_DETECTED" -eq 1 ]; then
    [ "$REMOTE_MODE" -eq 0 ] || fail "Both Nginx and Apache were detected. Use --web-server=nginx or --web-server=apache."
elif [ "$NGINX_DETECTED" -eq 1 ]; then
    WEB_SERVER=nginx
elif [ "$APACHE_DETECTED" -eq 1 ]; then
    WEB_SERVER=apache
elif [ "$REMOTE_MODE" -eq 1 ]; then
    WEB_SERVER=nginx
fi
WEB_SERVER_WAS_PRESENT=0
if [ "$WEB_SERVER" = nginx ] && [ "$NGINX_DETECTED" -eq 1 ]; then WEB_SERVER_WAS_PRESENT=1; fi
if [ "$WEB_SERVER" = apache ] && [ "$APACHE_DETECTED" -eq 1 ]; then WEB_SERVER_WAS_PRESENT=1; fi
FPM_WAS_PRESENT=0
for candidate in php-fpm php-fpm8.2 php-fpm8.3 php-fpm8.4 php-fpm8.5; do command -v "$candidate" >/dev/null 2>&1 && FPM_WAS_PRESENT=1; done
WEB_SERVER_LABEL=$WEB_SERVER
if [ "$REMOTE_MODE" -eq 1 ] && [ "$WEB_SERVER" != none ]; then
    if [ "$WEB_SERVER_WAS_PRESENT" -eq 1 ]; then WEB_SERVER_LABEL="$WEB_SERVER (detected; reused)"
    else WEB_SERVER_LABEL="$WEB_SERVER (selected; not installed)"; fi
fi
case "$WEB_SERVER" in nginx) WEB_SERVER_NAME=Nginx ;; apache) WEB_SERVER_NAME=Apache ;; *) WEB_SERVER_NAME=None ;; esac
case "$WEB_SERVER:$PKG_MANAGER" in
    nginx:*) WEB_SERVER_PACKAGE=nginx; WEB_SERVER_SERVICE=nginx ;;
    apache:apt-get) WEB_SERVER_PACKAGE=apache2; WEB_SERVER_SERVICE=apache2 ;;
    apache:*) WEB_SERVER_PACKAGE=httpd; WEB_SERVER_SERVICE=httpd ;;
    *) WEB_SERVER_PACKAGE=""; WEB_SERVER_SERVICE="" ;;
esac

FPM_BINARY=""
FPM_VERSION=""
FPM_CONFIG=""
FPM_SOCKET="${ATUM_FPM_SOCKET:-}"
FPM_SERVICE=""
WEB_SERVICE=""
WEB_GROUP=""
WEB_CONFIG=""
WEB_ENABLE_LINK=""
WEB_CONFIG_TEST_BINARY=""
WEB_CONFIG_TEST_ARGUMENT=""
SERVICE_COMMAND="${ATUM_SERVICE_COMMAND:-systemctl}"
REMOTE_MISSING=""
remote_requirements() {
    REMOTE_MISSING=""
    [ "$KERNEL" = Linux ] || REMOTE_MISSING="${REMOTE_MISSING}${REMOTE_MISSING:+|}Linux host"
    command -v systemctl >/dev/null 2>&1 || REMOTE_MISSING="${REMOTE_MISSING}${REMOTE_MISSING:+|}systemd"
    command -v openssl >/dev/null 2>&1 || REMOTE_MISSING="${REMOTE_MISSING}${REMOTE_MISSING:+|}openssl"
    if [ "$WEB_SERVER" = nginx ]; then
        command -v nginx >/dev/null 2>&1 || REMOTE_MISSING="${REMOTE_MISSING}${REMOTE_MISSING:+|}Nginx"
    else
        command -v apache2 >/dev/null 2>&1 || command -v httpd >/dev/null 2>&1 || REMOTE_MISSING="${REMOTE_MISSING}${REMOTE_MISSING:+|}Apache"
    fi
    if [ "$PHP_OK" -eq 1 ]; then
        PHP_MM=$(php -r 'echo PHP_MAJOR_VERSION,".",PHP_MINOR_VERSION;' 2>/dev/null || true)
        FPM_BINARY=${ATUM_FPM_BINARY:-}
        if [ -z "$FPM_BINARY" ]; then
            for candidate in "php-fpm$PHP_MM" "php-fpm${PHP_MM%.*}" php-fpm; do
                FPM_BINARY=$(command -v "$candidate" 2>/dev/null || true); [ -z "$FPM_BINARY" ] || break
            done
        fi
        [ -n "$FPM_BINARY" ] || REMOTE_MISSING="${REMOTE_MISSING}${REMOTE_MISSING:+|}PHP-FPM"
        if [ -n "$FPM_BINARY" ]; then
            FPM_VERSION=$($FPM_BINARY -v 2>&1 | sed -n 's/^PHP \([0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -n1)
            [ -n "$FPM_VERSION" ] || FPM_VERSION=$PHP_MM
            [ "$FPM_VERSION" = "$PHP_MM" ] || REMOTE_MISSING="${REMOTE_MISSING}${REMOTE_MISSING:+|}matching PHP-FPM"
        fi
    else
        REMOTE_MISSING="${REMOTE_MISSING}${REMOTE_MISSING:+|}PHP-FPM cannot be evaluated until PHP is installed"
    fi
}

configure_remote() {
    case "$LISTEN_ADDRESS" in *[!0-9a-fA-F:.]*|'') fail "--listen-address must be a literal IPv4 or IPv6 address." ;; esac
    php -r 'exit(filter_var($argv[1], FILTER_VALIDATE_IP) === false ? 1 : 0);' "$LISTEN_ADDRESS" >/dev/null 2>&1 || fail "--listen-address must be a valid literal IPv4 or IPv6 address."
    case "$LISTEN_PORT" in *[!0-9]*|'') fail "--listen-port must be an integer from 1 to 65535." ;; esac
    [ "$LISTEN_PORT" -ge 1 ] 2>/dev/null && [ "$LISTEN_PORT" -le 65535 ] || fail "--listen-port must be an integer from 1 to 65535."
    command -v openssl >/dev/null 2>&1 || fail "Remote development requires the openssl command to generate its development certificate."
    if [ "$WEB_SERVER" = nginx ]; then command -v nginx >/dev/null 2>&1 || [ "${ATUM_WEB_SERVER:-}" = nginx ] || fail "Nginx was selected but is not installed."
    else { command -v apache2 >/dev/null 2>&1 || command -v httpd >/dev/null 2>&1 || [ "${ATUM_WEB_SERVER:-}" = apache ]; } || fail "Apache was selected but is not installed."; fi
    PHP_MM=$(php -r 'echo PHP_MAJOR_VERSION,".",PHP_MINOR_VERSION;' 2>/dev/null || true)
    [ -n "$PHP_MM" ] || fail "Remote development requires a working PHP 8.2 or newer CLI and matching PHP-FPM."
    FPM_BINARY=${ATUM_FPM_BINARY:-}
    if [ -z "$FPM_BINARY" ]; then
        for candidate in "php-fpm$PHP_MM" "php-fpm${PHP_MM%.*}" php-fpm; do
            FPM_BINARY=$(command -v "$candidate" 2>/dev/null || true); [ -z "$FPM_BINARY" ] || break
        done
    fi
    [ -n "$FPM_BINARY" ] || fail "Remote development requires PHP-FPM matching the selected PHP."
    case "$FPM_BINARY" in /*) ;; *) fail "PHP-FPM binary must resolve to an absolute path." ;; esac
    [ -x "$FPM_BINARY" ] || fail "PHP-FPM binary is not executable: $FPM_BINARY"
    FPM_VERSION=$($FPM_BINARY -v 2>&1 | sed -n 's/^PHP \([0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -n1)
    [ -n "$FPM_VERSION" ] || FPM_VERSION=$PHP_MM
    [ "$FPM_VERSION" = "$PHP_MM" ] || fail "PHP-FPM $FPM_VERSION does not match the selected PHP CLI $PHP_MM."
    if [ -n "${ATUM_FPM_POOL_DIR:-}" ]; then FPM_POOL_DIR=$ATUM_FPM_POOL_DIR
    elif [ -d "/etc/php/$FPM_VERSION/fpm/pool.d" ]; then FPM_POOL_DIR="/etc/php/$FPM_VERSION/fpm/pool.d"
    elif [ -d /etc/php-fpm.d ]; then FPM_POOL_DIR=/etc/php-fpm.d
    else fail "Unable to locate the existing PHP-FPM pool configuration directory."; fi
    FPM_CONFIG="$FPM_POOL_DIR/atum.conf"
    if [ "$FPM_POOL_DIR" = /etc/php-fpm.d ]; then
        FPM_SERVICE="${ATUM_FPM_SERVICE:-php-fpm}"; FPM_SOCKET=${FPM_SOCKET:-/run/php-fpm/atum-fpm.sock}
    else
        FPM_SERVICE="${ATUM_FPM_SERVICE:-php$FPM_VERSION-fpm}"; FPM_SOCKET=${FPM_SOCKET:-/run/php/atum-fpm.sock}
    fi
    if [ "$WEB_SERVER" = nginx ]; then
        WEB_CONFIG_TEST_BINARY=${ATUM_WEB_CONFIG_TEST_BINARY:-$(command -v nginx 2>/dev/null || true)}
        WEB_CONFIG_TEST_ARGUMENT=-t
        NGINX_DIR=${ATUM_NGINX_CONFIG_DIR:-/etc/nginx/conf.d}
        [ -d "$NGINX_DIR" ] || fail "Nginx configuration directory is unavailable: $NGINX_DIR"
        WEB_CONFIG="$NGINX_DIR/atum.conf"; WEB_SERVICE=${ATUM_WEB_SERVICE:-nginx}
        if getent group www-data >/dev/null 2>&1; then WEB_GROUP=www-data; else WEB_GROUP=${ATUM_WEB_GROUP:-nginx}; fi
    else
        if [ -n "${ATUM_WEB_CONFIG_TEST_BINARY:-}" ]; then WEB_CONFIG_TEST_BINARY=$ATUM_WEB_CONFIG_TEST_BINARY; WEB_CONFIG_TEST_ARGUMENT=${ATUM_WEB_CONFIG_TEST_ARGUMENT:-configtest}
        elif command -v apache2ctl >/dev/null 2>&1; then WEB_CONFIG_TEST_BINARY=$(command -v apache2ctl); WEB_CONFIG_TEST_ARGUMENT=configtest
        elif command -v apachectl >/dev/null 2>&1; then WEB_CONFIG_TEST_BINARY=$(command -v apachectl); WEB_CONFIG_TEST_ARGUMENT=configtest
        elif command -v httpd >/dev/null 2>&1; then WEB_CONFIG_TEST_BINARY=$(command -v httpd); WEB_CONFIG_TEST_ARGUMENT=-t
        else WEB_CONFIG_TEST_BINARY=$(command -v apache2 2>/dev/null || true); WEB_CONFIG_TEST_ARGUMENT=-t
        fi
        if [ -n "${ATUM_APACHE_CONFIG_DIR:-}" ]; then APACHE_DIR=$ATUM_APACHE_CONFIG_DIR
        elif [ -d /etc/apache2/sites-available ]; then APACHE_DIR=/etc/apache2/sites-available
        elif [ -d /etc/httpd/conf.d ]; then APACHE_DIR=/etc/httpd/conf.d
        else fail "Unable to locate a supported Apache vhost configuration directory."; fi
        WEB_CONFIG="$APACHE_DIR/atum.conf"
        if [ "$APACHE_DIR" = /etc/httpd/conf.d ]; then WEB_SERVICE=${ATUM_WEB_SERVICE:-httpd}; else WEB_SERVICE=${ATUM_WEB_SERVICE:-apache2}; fi
        if [ "$APACHE_DIR" = /etc/apache2/sites-available ]; then WEB_ENABLE_LINK="${ATUM_APACHE_ENABLED_DIR:-/etc/apache2/sites-enabled}/atum.conf"; fi
        if getent group www-data >/dev/null 2>&1; then WEB_GROUP=www-data; else WEB_GROUP=${ATUM_WEB_GROUP:-apache}; fi
    fi
    case "$WEB_CONFIG_TEST_BINARY" in /*) ;; *) fail "Unable to locate an absolute web-server configuration-test command." ;; esac
    [ -x "$WEB_CONFIG_TEST_BINARY" ] || fail "Web-server configuration-test command is not executable: $WEB_CONFIG_TEST_BINARY"
}

SERVICE_MANAGER=unknown
if command -v systemctl >/dev/null 2>&1; then
    SERVICE_MANAGER=systemd
elif command -v rc-service >/dev/null 2>&1; then
    SERVICE_MANAGER=openrc
elif command -v service >/dev/null 2>&1; then
    SERVICE_MANAGER=service
elif [ "$KERNEL" = Darwin ] && command -v launchctl >/dev/null 2>&1; then
    SERVICE_MANAGER=launchd
fi

KAMAILIO_BINARY=$(command -v kamailio 2>/dev/null || true)
KAMAILIO_VERSION=unknown
if [ -n "$KAMAILIO_BINARY" ]; then
    KAMAILIO_VERSION=$($KAMAILIO_BINARY -V 2>/dev/null | sed -n 's/^version:[[:space:]]*kamailio[[:space:]]*\([^[:space:]]*\).*/\1/p' | head -n 1)
    [ -n "$KAMAILIO_VERSION" ] || KAMAILIO_VERSION=unknown
fi

if [ -z "$KAMAILIO_CONFIG" ]; then
    for candidate in /etc/kamailio/kamailio.cfg /usr/local/etc/kamailio/kamailio.cfg; do
        [ -f "$candidate" ] && { KAMAILIO_CONFIG=$candidate; break; }
    done
fi

MISSING_EXT=""
if [ "$PHP_OK" -eq 1 ]; then
    for ext in pdo_sqlite session openssl; do
        php -r 'exit(extension_loaded($argv[1])?0:1);' "$ext" >/dev/null 2>&1 || MISSING_EXT="$MISSING_EXT $ext"
    done
fi

[ "$REMOTE_MODE" -eq 0 ] || remote_requirements

DB_SCHEMES=""
discover_db_schemes() {
    [ "$PHP_OK" -eq 1 ] || return 0
    [ -n "$KAMAILIO_CONFIG" ] && [ -r "$KAMAILIO_CONFIG" ] || return 0
    DB_SCHEMES=$(php -r '
        require $argv[1];
        try {
            $report = (new AtumKamailioScanner())->scan($argv[2]);
            echo implode(" ", $report["database_schemes"] ?? []);
        } catch (Throwable $e) {
            fwrite(STDERR, "Atum dependency discovery failed: " . $e->getMessage() . "\n");
            exit(2);
        }
    ' "$SOURCE_DIR/admin/libraries/Atum/Kamailio/Scanner.class.php" "$KAMAILIO_CONFIG") || fail "Unable to inspect the Kamailio configuration safely."
}
discover_db_schemes

print_detailed_preflight() {
    say "Atum GUI installation pre-flight"
    say ""
    say "WARNING          : DEVELOPMENT PREVIEW - NOT SUITABLE FOR PRODUCTION"
    say "Operating system : $OS_NAME"
    say "Package manager  : ${PKG_MANAGER:-not detected}"
    say "Service manager  : $SERVICE_MANAGER"
    say "Web server       : $WEB_SERVER_LABEL"
    say "PHP              : $PHP_VERSION (minimum $ATUM_MIN_PHP)"
    say "PHP-FPM          : ${FPM_BINARY:-missing}"
    if [ "$PHP_OK" -eq 1 ]; then
        say "Missing PHP ext  : ${MISSING_EXT:-none}"
    else
        say "Missing PHP ext  : unavailable until PHP is installed"
    fi
    say "Kamailio binary  : ${KAMAILIO_BINARY:-not found}"
    say "Kamailio version : $KAMAILIO_VERSION"
    say "Kamailio config  : ${KAMAILIO_CONFIG:-not found}"
    say "DB schemes seen  : ${DB_SCHEMES:-none/unknown}"
    say "Application      : $PREFIX"
    say "State            : $STATE_DIR"
    say "Configuration    : $CONFIG_DIR"
    [ "$REMOTE_MODE" -eq 0 ] || say "Remote HTTPS     : $LISTEN_ADDRESS:$LISTEN_PORT"
    say ""
}

print_normal_summary() {
    say "Atum 0.1 Development Preview"
    say "NOT SUITABLE FOR PRODUCTION"
    say ""
    if [ -n "$KAMAILIO_BINARY" ]; then
        if [ "$KAMAILIO_VERSION" = unknown ]; then
            say "Kamailio detected (version unknown)"
        else
            say "Kamailio $KAMAILIO_VERSION detected"
        fi
    elif [ -n "$KAMAILIO_CONFIG" ]; then
        say "Kamailio configuration detected"
    elif [ "$ALLOW_NO_KAMAILIO" -eq 1 ]; then
        say "Kamailio was not detected; proceeding only because --allow-no-kamailio was specified."
    else
        say "Kamailio was not detected."
    fi
    say "Configuration: ${KAMAILIO_CONFIG:-not found}"
    if [ "$REMOTE_MODE" -eq 1 ]; then
        if [ "$WEB_SERVER_WAS_PRESENT" -eq 1 ]; then
            say "Web server: $WEB_SERVER_NAME (existing installation will be reused)"
        else
            say "Web server: $WEB_SERVER_NAME (will be installed)"
        fi
        say "HTTPS bind: $LISTEN_ADDRESS:$LISTEN_PORT"
        say ""
        say "Preparing remote Atum installation"
    else
        say ""
        say "Preparing local Atum installation"
    fi
    say ""
}

if [ "$CHECK_ONLY" -eq 1 ]; then
    print_detailed_preflight
    CHECK_MISSING=""
    for utility in flock groupadd useradd; do
        command -v "$utility" >/dev/null 2>&1 || CHECK_MISSING="${CHECK_MISSING}${CHECK_MISSING:+|}${utility}"
    done
    [ "$PHP_OK" -eq 1 ] || CHECK_MISSING="${CHECK_MISSING}${CHECK_MISSING:+|}PHP 8.2 or newer CLI"
    [ -z "$MISSING_EXT" ] || CHECK_MISSING="${CHECK_MISSING}${CHECK_MISSING:+|}PHP extensions:$MISSING_EXT"
    [ -n "$KAMAILIO_CONFIG" ] || [ "$ALLOW_NO_KAMAILIO" -eq 1 ] || CHECK_MISSING="${CHECK_MISSING}${CHECK_MISSING:+|}Kamailio configuration"
    CHECK_MISSING="${CHECK_MISSING}${CHECK_MISSING:+|}${REMOTE_MISSING}"
    if [ -n "$CHECK_MISSING" ]; then
        say "Missing requirements:"
        printf '%s\n' "$CHECK_MISSING" | tr '|' '\n' | while IFS= read -r requirement; do [ -z "$requirement" ] || say "- $requirement"; done
        fail "Pre-flight failed: one or more requirements are missing."
    fi
    exit 0
fi

if [ "$VERBOSE" -eq 1 ]; then
    print_detailed_preflight
    say "Preparing $([ "$REMOTE_MODE" -eq 1 ] && printf '%s' remote || printf '%s' local) Atum installation"
    say ""
else
    print_normal_summary
fi

stage_begin 1 "Checking host"

command -v groupadd >/dev/null 2>&1 || fail "This v0.1 system installer requires groupadd; use --check only on other platforms."
command -v useradd >/dev/null 2>&1 || fail "This v0.1 system installer requires useradd; use --check only on other platforms."
if [ -z "$KAMAILIO_CONFIG" ]; then
    [ "$ALLOW_NO_KAMAILIO" -eq 1 ] || fail "No existing Kamailio configuration found."
else
    [ -r "$KAMAILIO_CONFIG" ] || fail "Kamailio configuration is not readable: $KAMAILIO_CONFIG"
fi

recover_transaction() {
    [ -d "$TRANSACTION_DIR" ] || return 0
    [ "$(stat -c %u "$TRANSACTION_DIR" 2>/dev/null || echo -1)" = 0 ] || fail "Interrupted-install journal is not root-owned: $TRANSACTION_DIR"
    if [ ! -e "$TRANSACTION_DIR/install-id" ] && [ -z "$(find "$TRANSACTION_DIR" -mindepth 1 -maxdepth 1 -print -quit)" ]; then rmdir "$TRANSACTION_DIR"; return 0; fi
    old_id=$(sed -n '1p' "$TRANSACTION_DIR/install-id" 2>/dev/null || true)
    case "$old_id" in *[!a-f0-9]*|'') fail "Interrupted-install journal has an invalid installation ID." ;; esac
    old_config=$(sed -n '1p' "$TRANSACTION_DIR/configuration" 2>/dev/null || true)
    if [ -n "$old_config" ] && [ -r "$old_config/install-ledger.json" ] && grep -q '"install_id": "'"$old_id"'"' "$old_config/install-ledger.json"; then
        find "$TRANSACTION_DIR" -mindepth 1 -maxdepth 1 -type f -exec rm -f {} \;
        rmdir "$TRANSACTION_DIR"
        return 0
    fi
    say "Recovering interrupted Atum installation $old_id"
    for record in "$TRANSACTION_DIR"/host-created-*; do
        [ -f "$record" ] || continue
        kind=$(sed -n '1p' "$record"); old_path=$(sed -n '2p' "$record"); expected=$(sed -n '3p' "$record")
        case "$old_path" in /*) ;; *) fail "Interrupted-install journal contains an unsafe host path." ;; esac
        [ "$old_path" != / ] || fail "Interrupted-install journal contains an unsafe host path."
        if [ "$kind" = file ] && [ -f "$old_path" ]; then
            actual=$(sha256sum "$old_path" | awk '{print $1}')
            [ "$actual" = "$expected" ] || fail "Interrupted Atum host file changed; refusing to remove it: $old_path"
            rm -f "$old_path"
        elif [ "$kind" = symlink ] && [ -L "$old_path" ]; then
            [ "$(readlink "$old_path")" = "$expected" ] || fail "Interrupted Atum host symlink changed; refusing to remove it: $old_path"
            rm -f "$old_path"
        elif [ "$kind" = transient ]; then
            if [ -e "$old_path" ] || [ -L "$old_path" ]; then
                [ -f "$old_path" ] && [ ! -L "$old_path" ] \
                    || fail "Interrupted Atum transient host path is not a regular file: $old_path"
                rm -f "$old_path"
            fi
        fi
    done
    for record in "$TRANSACTION_DIR"/package-service-mask-*; do
        [ -f "$record" ] || continue
        old_service=$(sed -n '1p' "$record")
        case "$old_service" in *[!A-Za-z0-9@_.-]*|'') fail "Interrupted-install journal contains an invalid service mask." ;; esac
        "$SERVICE_COMMAND" unmask "$old_service" >/dev/null 2>&1 || fail "Unable to remove a temporary web-server service mask during recovery."
    done
    for record in "$TRANSACTION_DIR"/package-enabled-unit-*; do
        [ -f "$record" ] || continue
        old_unit=$(sed -n '1p' "$record")
        case "$old_unit" in *[!A-Za-z0-9@_.-]*|'') fail "Interrupted-install journal contains an invalid enabled unit." ;; esac
        "$SERVICE_COMMAND" disable --now "$old_unit" >/dev/null 2>&1 || fail "Unable to disable package-enabled unit during recovery: $old_unit"
    done
    for record in "$TRANSACTION_DIR"/reload-service-*; do
        [ -f "$record" ] || continue
        old_service=$(sed -n '1p' "$record")
        case "$old_service" in *[!A-Za-z0-9@_.-]*|'') fail "Interrupted-install journal contains an invalid service name." ;; esac
        "$SERVICE_COMMAND" reload "$old_service" >/dev/null 2>&1 || true
    done
    for key in application-stage application state configuration; do
        [ -f "$TRANSACTION_DIR/intended-$key" ] || [ -f "$TRANSACTION_DIR/created-$key" ] || continue
        old_path=$(sed -n '1p' "$TRANSACTION_DIR/$key")
        case "$old_path" in /*) ;; *) fail "Interrupted-install journal contains an unsafe path." ;; esac
        [ "$old_path" != / ] || fail "Interrupted-install journal contains an unsafe path."
        if [ -e "$old_path" ]; then
            marker="$old_path/.atum-provisional-install-id"
            committed_marker="$old_path/.atum-install-id"
            if ! { { [ -r "$marker" ] && [ "$(sed -n '1p' "$marker")" = "$old_id" ]; } || { [ -r "$committed_marker" ] && [ "$(sed -n '1p' "$committed_marker")" = "$old_id" ]; }; }; then
                [ -d "$old_path" ] && [ -z "$(find "$old_path" -mindepth 1 -maxdepth 1 -print -quit)" ] || fail "Interrupted path has no matching provisional ownership marker: $old_path"
            fi
            php -r '$p=$argv[1]; $it=new RecursiveIteratorIterator(new RecursiveDirectoryIterator($p,FilesystemIterator::SKIP_DOTS),RecursiveIteratorIterator::CHILD_FIRST); foreach($it as $i){$i->isDir()&&!$i->isLink()?rmdir($i->getPathname()):unlink($i->getPathname());} rmdir($p);' "$old_path" || fail "Unable to recover $old_path"
        fi
    done
    if [ -s "$TRANSACTION_DIR/packages-added" ]; then RECOVERED_PACKAGES=$(tr '\n' ' ' < "$TRANSACTION_DIR/packages-added" | sed 's/[[:space:]]*$//'); say "Retaining and carrying forward packages from interrupted installation: $RECOVERED_PACKAGES"; fi
    if id atum >/dev/null 2>&1; then
        if [ -f "$TRANSACTION_DIR/user-created" ]; then
            userdel atum >/dev/null 2>&1 || fail "Unable to remove Atum user while recovering interrupted installation."
        elif [ -f "$TRANSACTION_DIR/intended-user" ]; then
            fail "An atum user exists after an interrupted creation attempt, but Atum cannot prove that it created the account. Refusing to remove it."
        fi
    fi
    if (command -v getent >/dev/null 2>&1 && getent group atum >/dev/null 2>&1) || grep -q '^atum:' /etc/group 2>/dev/null; then
        if [ -f "$TRANSACTION_DIR/group-created" ]; then
            groupdel atum >/dev/null 2>&1 || fail "Unable to remove Atum group while recovering interrupted installation."
        elif [ -f "$TRANSACTION_DIR/intended-group" ]; then
            fail "An atum group exists after an interrupted creation attempt, but Atum cannot prove that it created the group. Refusing to remove it."
        fi
    fi
    find "$TRANSACTION_DIR" -mindepth 1 -maxdepth 1 -type f -exec rm -f {} \;
    rmdir "$TRANSACTION_DIR"
}

recover_transaction
[ ! -e "$PREFIX" ] || fail "Atum is already present at $PREFIX. v0.1 has no supported in-place upgrade path; do not overwrite an installation."
[ ! -e "$STATE_DIR" ] || fail "Atum state already exists at $STATE_DIR. Refusing to overwrite it."
[ ! -e "$CONFIG_DIR" ] || fail "Atum configuration already exists at $CONFIG_DIR. Refusing to overwrite it."
INSTALL_ID=$(openssl rand -hex 16 2>/dev/null || php -r 'echo bin2hex(random_bytes(16));' 2>/dev/null || od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
mkdir -m 0700 "$TRANSACTION_DIR"
journal_put() { printf '%s\n' "$2" > "$TRANSACTION_DIR/.$1.tmp"; chmod 0600 "$TRANSACTION_DIR/.$1.tmp"; mv "$TRANSACTION_DIR/.$1.tmp" "$TRANSACTION_DIR/$1"; }
journal_put install-id "$INSTALL_ID"
journal_put application "$PREFIX"
journal_put state "$STATE_DIR"
journal_put configuration "$CONFIG_DIR"
chmod 0600 "$TRANSACTION_DIR"/*
[ -z "$RECOVERED_PACKAGES" ] || printf '%s\n' $RECOVERED_PACKAGES > "$TRANSACTION_DIR/packages-added"

PACKAGE_START_SUPPRESSION=""
DEFAULT_SITE_RECORD=""
enable_package_start_suppression() {
    [ -z "$PACKAGE_START_SUPPRESSION" ] || return 0
    case "$PKG_MANAGER" in
        apt-get)
            policy_rc_d=${ATUM_POLICY_RC_D:-/usr/sbin/policy-rc.d}
            [ ! -e "$policy_rc_d" ] || fail "Refusing to replace existing package service policy: $policy_rc_d"
            (umask 077; printf '%s\n' '#!/bin/sh' 'exit 101' > "$policy_rc_d") || fail "Unable to create temporary package service policy."
            chmod 0700 "$policy_rc_d"
            PACKAGE_START_SUPPRESSION=$policy_rc_d
            ;;
        dnf|yum)
            "$SERVICE_COMMAND" mask "${WEB_SERVER_SERVICE}.service" || fail "Unable to temporarily mask the newly installed web-server service."
            PACKAGE_START_SUPPRESSION="mask:${WEB_SERVER_SERVICE}.service"
            printf '%s\n' "${WEB_SERVER_SERVICE}.service" > "$TRANSACTION_DIR/package-service-mask-1"
            chmod 0600 "$TRANSACTION_DIR/package-service-mask-1"
            ;;
        *) return 0 ;;
    esac
    if [ -n "$PACKAGE_START_SUPPRESSION" ] && [ "${PACKAGE_START_SUPPRESSION#mask:}" = "$PACKAGE_START_SUPPRESSION" ]; then
        printf '%s\n%s\n' transient "$PACKAGE_START_SUPPRESSION" > "$TRANSACTION_DIR/host-created-package-start-suppression"
        chmod 0600 "$TRANSACTION_DIR/host-created-package-start-suppression"
    fi
}

remove_package_start_suppression() {
    case "$PACKAGE_START_SUPPRESSION" in
        /*)
            [ ! -e "$PACKAGE_START_SUPPRESSION" ] || rm -f "$PACKAGE_START_SUPPRESSION" || fail "Unable to remove temporary package service policy."
            ;;
        mask:*) "$SERVICE_COMMAND" unmask "${PACKAGE_START_SUPPRESSION#mask:}" || fail "Unable to remove temporary web-server service mask." ;;
    esac
    PACKAGE_START_SUPPRESSION=""
    rm -f "$TRANSACTION_DIR/host-created-package-start-suppression"
    rm -f "$TRANSACTION_DIR/package-service-mask-1"
}

restore_default_site() {
    [ -n "$DEFAULT_SITE_RECORD" ] || return 0
    default_path=$(sed -n '1p' "$DEFAULT_SITE_RECORD"); default_target=$(sed -n '2p' "$DEFAULT_SITE_RECORD")
    if [ -L "$default_path" ] && [ "$(readlink "$default_path")" = "$default_target" ]; then DEFAULT_SITE_RECORD=""; return 0; fi
    [ ! -e "$default_path" ] && [ ! -L "$default_path" ] || fail "Default site changed while restoring failed installation: $default_path"
    ln -s "$default_target" "$default_path" || fail "Unable to restore default web-server site after failed installation."
    DEFAULT_SITE_RECORD=""
}

disable_new_web_server_default_site() {
    [ "$WEB_SERVER_WAS_PRESENT" -eq 0 ] || return 0
    case "$WEB_SERVER" in
        nginx)
            default_path=${ATUM_NGINX_DEFAULT_SITE:-/etc/nginx/sites-enabled/default}
            ;;
        apache)
            default_path=${ATUM_APACHE_DEFAULT_SITE:-/etc/apache2/sites-enabled/000-default.conf}
            ;;
    esac
    [ -L "$default_path" ] || return 0
    default_target=$(readlink "$default_path")
    case "$WEB_SERVER:$default_target" in
        nginx:../sites-available/default|nginx:/etc/nginx/sites-available/default|apache:../sites-available/000-default.conf|apache:/etc/apache2/sites-available/000-default.conf) ;;
        *) fail "Refusing to disable a non-standard web-server default site: $default_path" ;;
    esac
    DEFAULT_SITE_RECORD="$TRANSACTION_DIR/web-default-disabled-1"
    printf '%s\n%s\n' "$default_path" "$default_target" > "$DEFAULT_SITE_RECORD"
    chmod 0600 "$DEFAULT_SITE_RECORD"
    rm "$default_path" || fail "Unable to disable the package default web-server site."
}

snapshot_packages() {
    case "$PKG_MANAGER" in
        apt-get) dpkg-query -W -f='${binary:Package}\n' 2>/dev/null | sort -u ;;
        dnf|yum) rpm -qa --qf '%{NAME}\n' 2>/dev/null | sort -u ;;
        *) : ;;
    esac
}

BEFORE=$(mktemp)
AFTER=$(mktemp)
ENABLED_BEFORE=$(mktemp)
ENABLED_AFTER=$(mktemp)
PACKAGE_OUTPUT=$(mktemp)
ADMINISTRATOR_OUTPUT=$(mktemp)
snapshot_enabled_units() { "$SERVICE_COMMAND" list-unit-files --state=enabled --no-legend --no-pager 2>/dev/null | awk '{print $1}' | sort -u; }
rollback_install() {
    status=$?
    trap - EXIT HUP INT TERM
    rm -f "$BEFORE" "$AFTER" "$ENABLED_BEFORE" "$ENABLED_AFTER" "$PACKAGE_OUTPUT" "$ADMINISTRATOR_OUTPUT"
    if [ "$status" -ne 0 ] && [ "$INSTALL_COMMITTED" -eq 0 ]; then
        remove_package_start_suppression || true
        for record in "$TRANSACTION_DIR"/package-enabled-unit-*; do
            [ -f "$record" ] || continue
            unit=$(sed -n '1p' "$record")
            "$SERVICE_COMMAND" disable --now "$unit" >/dev/null 2>&1 || true
        done
        [ "$USER_CREATED" -eq 1 ] && command -v userdel >/dev/null 2>&1 && userdel atum >/dev/null 2>&1 || true
        [ "$GROUP_CREATED" -eq 1 ] && command -v groupdel >/dev/null 2>&1 && groupdel atum >/dev/null 2>&1 || true
        [ -z "$PACKAGES_ADDED" ] || say "Retaining packages after failed installation; safe reverse-dependency removal is deferred to recovery: $PACKAGES_ADDED"
    fi
    exit "$status"
}
trap rollback_install EXIT HUP INT TERM
snapshot_packages > "$BEFORE"
snapshot_enabled_units > "$ENABLED_BEFORE"
stage_done
stage_begin 2 "Installing system dependencies"

refresh_packages_added() {
    snapshot_packages > "$AFTER"
    current_added=$(comm -13 "$BEFORE" "$AFTER" | tr '\n' ' ' | sed 's/[[:space:]]*$//')
    PACKAGES_ADDED=$(printf '%s\n%s\n' "$RECOVERED_PACKAGES" "$current_added" | tr ' ' '\n' | sed '/^$/d' | sort -u | tr '\n' ' ' | sed 's/[[:space:]]*$//')
    printf '%s\n' $PACKAGES_ADDED > "$TRANSACTION_DIR/packages-added.tmp"
    chmod 0600 "$TRANSACTION_DIR/packages-added.tmp"
    mv "$TRANSACTION_DIR/packages-added.tmp" "$TRANSACTION_DIR/packages-added"
}

record_newly_enabled_units() {
    snapshot_enabled_units > "$ENABLED_AFTER"
    unit_number=$(find "$TRANSACTION_DIR" -maxdepth 1 -name 'package-enabled-unit-*' -type f | wc -l)
    comm -13 "$ENABLED_BEFORE" "$ENABLED_AFTER" > "$TRANSACTION_DIR/.new-enabled-units"
    while IFS= read -r unit; do
        [ -n "$unit" ] || continue
        unit_number=$((unit_number + 1))
        printf '%s\n' "$unit" > "$TRANSACTION_DIR/package-enabled-unit-$unit_number"
        chmod 0600 "$TRANSACTION_DIR/package-enabled-unit-$unit_number"
    done < "$TRANSACTION_DIR/.new-enabled-units"
    rm -f "$TRANSACTION_DIR/.new-enabled-units"
}

package_is_installed() {
    case "$PKG_MANAGER" in
        apt-get) [ "$(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null || true)" = installed ] ;;
        dnf|yum) rpm -q "$1" >/dev/null 2>&1 ;;
        *) return 1 ;;
    esac
}

missing_packages() {
    for package in "$@"; do package_is_installed "$package" || printf '%s\n' "$package"; done
}

describe_packages() {
    need_php=0
    need_fpm=0
    need_sqlite=0
    need_https=0
    need_nginx=0
    need_apache=0
    for package in "$@"; do
        case "$package" in
            php-cli|php-common) need_php=1 ;;
            php-fpm) need_fpm=1 ;;
            php-sqlite3|php-pdo) need_sqlite=1 ;;
            openssl) need_https=1 ;;
            nginx) need_nginx=1 ;;
            apache2|httpd) need_apache=1 ;;
        esac
    done
    say ""
    say "Atum requires:"
    if [ "$need_php" -eq 1 ] && [ "$need_fpm" -eq 1 ]; then
        say "  PHP 8.2 or newer and PHP-FPM"
    elif [ "$need_php" -eq 1 ]; then
        say "  PHP 8.2 or newer"
    elif [ "$need_fpm" -eq 1 ]; then
        PHP_MM=$(php -r 'echo PHP_MAJOR_VERSION,".",PHP_MINOR_VERSION;' 2>/dev/null || true)
        say "  PHP ${PHP_MM:-8.2 or newer} and matching PHP-FPM"
    fi
    [ "$need_sqlite" -eq 0 ] || say "  SQLite support for PHP"
    [ "$need_nginx" -eq 0 ] || say "  Nginx web server"
    [ "$need_apache" -eq 0 ] || say "  Apache web server"
    [ "$need_https" -eq 0 ] || say "  HTTPS certificate support"
    [ "$VERBOSE" -eq 0 ] || say "  Packages: $*"
}

confirm_packages() {
    describe_packages "$@"
    if [ "$ASSUME_YES" -eq 1 ]; then
        say "Install required packages? yes (--yes)"
        return 0
    fi
    [ -r /dev/tty ] || { say "Package installation needs confirmation; rerun with --yes for non-interactive use." >&2; return 1; }
    printf 'Install required packages? [y/N] ' > /dev/tty
    read answer < /dev/tty || return 1
    case "$answer" in y|Y|yes|YES|Yes) return 0 ;; *) return 1 ;; esac
}

install_packages() {
    [ "$NO_DEPS" -eq 0 ] || return 1
    confirm_packages "$@" || return 1
    package_contains_web_server=0
    for package in "$@"; do
        [ "$package" = "$WEB_SERVER_PACKAGE" ] && package_contains_web_server=1
    done
    if [ "$REMOTE_MODE" -eq 1 ] && [ "$WEB_SERVER_WAS_PRESENT" -eq 0 ] && [ "$package_contains_web_server" -eq 1 ]; then
        enable_package_start_suppression
    fi
    case "$PKG_MANAGER" in
        apt-get)
            if [ "$VERBOSE" -eq 1 ]; then
                DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$@" || { remove_package_start_suppression || true; refresh_packages_added; return 1; }
            elif ! ATUM_PRESENTATION_COMMAND=run-quiet "$SOURCE_DIR/installer/presentation.sh" \
                "$PACKAGE_OUTPUT" "Installing required packages" -- \
                env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$@"; then
                say "Package installation failed; package-manager output follows:" >&2
                cat "$PACKAGE_OUTPUT" >&2
                remove_package_start_suppression || true
                refresh_packages_added
                return 1
            fi
            ;;
        dnf|yum)
            if [ "$VERBOSE" -eq 1 ]; then
                "$PKG_MANAGER" install -y "$@" || { remove_package_start_suppression || true; refresh_packages_added; return 1; }
            elif ! ATUM_PRESENTATION_COMMAND=run-quiet "$SOURCE_DIR/installer/presentation.sh" \
                "$PACKAGE_OUTPUT" "Installing required packages" -- \
                "$PKG_MANAGER" install -y "$@"; then
                say "Package installation failed; package-manager output follows:" >&2
                cat "$PACKAGE_OUTPUT" >&2
                remove_package_start_suppression || true
                refresh_packages_added
                return 1
            fi
            ;;
        *) return 1 ;;
    esac
    refresh_packages_added
    record_newly_enabled_units
    if [ "$package_contains_web_server" -eq 1 ]; then
        disable_new_web_server_default_site
        remove_package_start_suppression
    fi
}

if [ "$REMOTE_MODE" -eq 1 ] && [ "$WEB_SERVER_WAS_PRESENT" -eq 0 ] && [ "$NO_DEPS" -eq 0 ]; then
    case "$PKG_MANAGER" in
        dnf|yum) fail "Automatic new web-server provisioning is currently implemented only for APT-family systems. Install Nginx or Apache yourself and rerun Atum." ;;
    esac
fi

if [ "$PHP_OK" -ne 1 ]; then
    if command -v php >/dev/null 2>&1; then
        fail "PHP $PHP_VERSION is too old. Atum will not add third-party repositories automatically."
    fi
    case "$PKG_MANAGER" in
        apt-get)
            packages=$(missing_packages php-cli php-common | tr '\n' ' ')
            if [ "$REMOTE_MODE" -eq 1 ]; then
                packages="$packages $(missing_packages php-fpm php-sqlite3 openssl | tr '\n' ' ')"
                [ "$WEB_SERVER" = nginx ] && packages="$packages $(missing_packages nginx | tr '\n' ' ')" || packages="$packages $(missing_packages apache2 | tr '\n' ' ')"
            fi
            install_packages $packages || fail "Install PHP >= 8.2 and rerun."
            ;;
        dnf|yum)
            packages=$(missing_packages php-cli php-common | tr '\n' ' ')
            if [ "$REMOTE_MODE" -eq 1 ]; then
                packages="$packages $(missing_packages php-fpm php-pdo openssl | tr '\n' ' ')"
                [ "$WEB_SERVER" = nginx ] && packages="$packages $(missing_packages nginx | tr '\n' ' ')" || packages="$packages $(missing_packages httpd | tr '\n' ' ')"
            fi
            install_packages $packages || fail "Install PHP >= 8.2 and rerun."
            ;;
        *) fail "Install PHP >= 8.2 and rerun." ;;
    esac
fi

PHP_VERSION=$(php -r 'echo PHP_VERSION;' 2>/dev/null || echo missing)
PHP_OK=0
php -r 'exit(version_compare(PHP_VERSION,"8.2.0",">=")?0:1);' >/dev/null 2>&1 && PHP_OK=1
[ "$PHP_OK" -eq 1 ] || fail "PHP $PHP_VERSION is unsuitable. Atum will not add third-party repositories automatically."

# Re-evaluate required baseline extensions after PHP installation.
MISSING_EXT=""
for ext in pdo_sqlite session openssl; do
    php -r 'exit(extension_loaded($argv[1])?0:1);' "$ext" >/dev/null 2>&1 || MISSING_EXT="$MISSING_EXT $ext"
done

for ext in $MISSING_EXT; do
    case "$ext:$PKG_MANAGER" in
        pdo_sqlite:apt-get) install_packages php-sqlite3 || fail "Missing pdo_sqlite; install php-sqlite3." ;;
        pdo_sqlite:dnf|pdo_sqlite:yum) install_packages php-pdo || fail "Missing pdo_sqlite; install a PHP SQLite/PDO package." ;;
        *) fail "Missing required PHP extension: $ext" ;;
    esac
done

if [ "$REMOTE_MODE" -eq 1 ]; then
    remote_packages=""
    command -v openssl >/dev/null 2>&1 || remote_packages="$remote_packages $(missing_packages openssl | tr '\n' ' ')"
    if [ "$WEB_SERVER" = nginx ]; then
        command -v nginx >/dev/null 2>&1 || remote_packages="$remote_packages $(missing_packages nginx | tr '\n' ' ')"
    else
        command -v apache2 >/dev/null 2>&1 || command -v httpd >/dev/null 2>&1 || remote_packages="$remote_packages $(missing_packages "$WEB_SERVER_PACKAGE" | tr '\n' ' ')"
    fi
    remote_requirements
    case "$REMOTE_MISSING" in *PHP-FPM*|*matching\ PHP-FPM*)
        case "$PKG_MANAGER" in apt-get) remote_packages="$remote_packages $(missing_packages php-fpm | tr '\n' ' ')" ;; dnf|yum) remote_packages="$remote_packages $(missing_packages php-fpm php-pdo | tr '\n' ' ')" ;; esac ;;
    esac
    [ -z "$remote_packages" ] || install_packages $remote_packages || fail "Remote development dependencies are missing; rerun without --no-deps to install native packages."
    remote_requirements
    [ -z "$REMOTE_MISSING" ] || fail "Remote development requirements remain unsatisfied: $(printf '%s' "$REMOTE_MISSING" | tr '|' ',')"
    configure_remote
fi

refresh_packages_added
discover_db_schemes
[ "$VERBOSE" -eq 0 ] || say "Kamailio DB use : ${DB_SCHEMES:-none/unknown} (reported only; adapters are module dependencies)"
stage_done
stage_begin 3 "Creating Atum service account"

if (command -v getent >/dev/null 2>&1 && getent group atum >/dev/null 2>&1) || id atum >/dev/null 2>&1 || grep -q '^atum:' /etc/group 2>/dev/null; then
    fail "A pre-existing user or group named 'atum' exists. Refusing to reuse an identity Atum did not create."
fi
journal_put intended-group 1
groupadd --system atum
GROUP_CREATED=1
journal_put group-created 1
NOLOGIN_SHELL=$(command -v nologin 2>/dev/null || printf '%s' /usr/sbin/nologin)
journal_put intended-user 1
useradd --system --gid atum --home-dir "$STATE_DIR" --shell "$NOLOGIN_SHELL" atum
USER_CREATED=1
journal_put user-created 1
stage_done

exec 7> "$ADMINISTRATOR_OUTPUT"
ATUM_INSTALL_BOOTSTRAPPED=1 php "$SOURCE_DIR/install.php" \
    --prefix="$PREFIX" \
    --state-dir="$STATE_DIR" \
    --config-dir="$CONFIG_DIR" \
    --kamailio-config="$KAMAILIO_CONFIG" \
    --os-id="$OS_ID" \
    --package-manager="$PKG_MANAGER" \
    --packages-added="$PACKAGES_ADDED" \
    --user-created="$USER_CREATED" \
    --group-created="$GROUP_CREATED" \
    --install-id="$INSTALL_ID" \
    --transaction-dir="$TRANSACTION_DIR" \
    --remote="$REMOTE_MODE" \
    --listen-address="$LISTEN_ADDRESS" \
    --listen-port="$LISTEN_PORT" \
    --web-server="$WEB_SERVER" \
    --web-config="$WEB_CONFIG" \
    --web-enable-link="$WEB_ENABLE_LINK" \
    --web-service="$WEB_SERVICE" \
    --web-group="$WEB_GROUP" \
    --fpm-config="$FPM_CONFIG" \
    --fpm-socket="$FPM_SOCKET" \
    --fpm-service="$FPM_SERVICE" \
    --fpm-binary="$FPM_BINARY" \
    --web-config-test-binary="$WEB_CONFIG_TEST_BINARY" \
    --web-config-test-argument="$WEB_CONFIG_TEST_ARGUMENT" \
    --start-web-service="$([ "$WEB_SERVER_WAS_PRESENT" -eq 0 ] && printf '%s' 1 || printf '%s' 0)" \
    --start-fpm-service="$([ "$FPM_WAS_PRESENT" -eq 0 ] && printf '%s' 1 || printf '%s' 0)" \
    --progress=1 \
    --verbose="$VERBOSE" \
    --administrator-output-fd=7 \
    --service-command="$SERVICE_COMMAND" \
    --openssl="$(command -v openssl 2>/dev/null || true)"
exec 7>&-

ADMINISTRATOR=$(sed -n '1p' "$ADMINISTRATOR_OUTPUT")
case "$ADMINISTRATOR" in *[!A-Za-z0-9_.-]*|'') ADMINISTRATOR= ;; esac

INSTALL_COMMITTED=1
find "$TRANSACTION_DIR" -mindepth 1 -maxdepth 1 -type f -exec rm -f {} \;
rmdir "$TRANSACTION_DIR"

if [ "$REMOTE_MODE" -eq 1 ]; then
    HOST_ADDRESSES=$(hostname -I 2>/dev/null || true)
    OPEN_URL=$(atum_https_url "$LISTEN_ADDRESS" "$LISTEN_PORT" "$HOST_ADDRESSES" "${SSH_CONNECTION:-}")
else
    OPEN_URL=
fi
atum_print_completion "$PREFIX" "$ADMINISTRATOR" "$REMOTE_MODE" "$WEB_SERVER_NAME" \
    "$LISTEN_ADDRESS" "$LISTEN_PORT" "$OPEN_URL"
